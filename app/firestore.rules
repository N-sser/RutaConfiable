rules_version = '2';

// Reglas de Ruta Confiable.
// - La verificación de identidad (verified, verificationStatus, ...) SOLO la cambia un administrador.
// - Un administrador es un usuario con un documento en admins/{uid} (se crea a mano desde la
//   consola de Firebase; ninguna app puede crearlo).
// - Solo conductores verificados pueden publicar viajes y solo clientes verificados reservan.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    match /admins/{uid} {
      // Cada usuario solo puede comprobar si él mismo es administrador.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Al registrarse, la cuenta nace SIEMPRE sin verificar.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.role in ['client', 'driver'];

      allow update: if
        // El administrador solo puede tocar los campos de verificación.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['verified', 'verificationStatus', 'rejectionReason',
                         'verifiedAt', 'reviewedBy']))
        // El dueño puede editar su perfil, pero no la verificación ni el rol.
        || (signedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['verified', 'verificationStatus', 'rejectionReason',
                        'verifiedAt', 'reviewedBy', 'role']));

      allow delete: if false;
    }

    match /trips/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.driverUid == request.auth.uid
        && userData(request.auth.uid).role == 'driver'
        && userData(request.auth.uid).verified == true
        && request.resource.data.driverVerified == true;

      allow update: if signedIn() && (
        // El conductor edita su propio viaje (sin cambiar dueño ni verificación).
        (resource.data.driverUid == request.auth.uid
          && request.resource.data.driverUid == resource.data.driverUid
          && request.resource.data.driverVerified == resource.data.driverVerified)
        // Un cliente solo puede BAJAR cupos o kilos libres, y solo si en la misma operación
        // crea su reserva "<códigoViaje>_<uidCliente>" (así no se pueden restar a escondidas).
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['seatsFree', 'cargoFreeKg'])
            && request.resource.data.seatsFree >= 0
            && request.resource.data.cargoFreeKg >= 0
            && request.resource.data.seatsFree <= resource.data.seatsFree
            && request.resource.data.cargoFreeKg <= resource.data.cargoFreeKg
            && !exists(/databases/$(database)/documents/bookings/$(code + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/bookings/$(code + '_' + request.auth.uid)))
      );

      allow delete: if signedIn() && resource.data.driverUid == request.auth.uid;
    }

    // Reservas: las crea un cliente verificado (id "<códigoViaje>_<uidCliente>", una por viaje).
    // Las leen el cliente que reservó y el conductor del viaje. Nadie las edita ni borra.
    match /bookings/{bookingId} {
      allow read: if signedIn() && (
        resource.data.clientUid == request.auth.uid
        || resource.data.tripDriverUid == request.auth.uid
        || isAdmin());

      allow create: if signedIn()
        && bookingId == request.resource.data.tripId + '_' + request.auth.uid
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && userData(request.auth.uid).role == 'client'
        && userData(request.auth.uid).verified == true;

      allow update, delete: if false;
    }
  }
}
